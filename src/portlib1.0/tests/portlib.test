    set ::portlib::toolchain::sdk_info_cache [dict create]
    unset ::_ch_sdkdir
} -result {0}


test coherence_metal_not_checked_without_needs_metal {
    Axis C must not run at all -- not even a metal_info call -- for a
    port that never set needs_metal. Proven by checking metal_info_cache
    remains unpopulated for the ctx developer_dir afterward, rather than
    by disabling exec (which Axis A/B's real plutil call still needs).
} -setup {
    set ::_ch_sdkdir $pwd/tmp_coherence_no_metal/MacOSX27.sdk
    _coherence_make_sdk $::_ch_sdkdir 27.0 macosx27.0
    set ::portlib::toolchain::sdk_info_cache [dict create]
    set ::portlib::toolchain::metal_info_cache [dict create]
} -body {
    set ctx [dict create \
        sdk_request     27 \
        sdkroot         $::_ch_sdkdir \
        developer_dir   /_test_coherence_no_metal/Xcode.app/Contents/Developer \
        use_xcode       1 \
        xcodeversion    27.0 \
        xcodecltversion 27.0 \
        compiler        clang \
        needs_metal     0]
    set findings [portlib::toolchain::check_coherence $ctx]
    list [llength $findings] \
        [dict exists $::portlib::toolchain::metal_info_cache \
            /_test_coherence_no_metal/Xcode.app/Contents/Developer]
} -cleanup {
    file delete -force $pwd/tmp_coherence_no_metal
    set ::portlib::toolchain::sdk_info_cache [dict create]
    set ::portlib::toolchain::metal_info_cache [dict create]
    unset ::_ch_sdkdir
} -result {0 0}


test coherence_metal_suffix_difference_is_silent {
    Axis C compares build TRAINS, not full build strings: Xcode build
    27A266a and Metal build 27A300b share train "27A", differing only in
    suffix -- must be silent. sdkroot left empty so Axis A/B (both
    already covered above) are cleanly out of the picture.
} -setup {
    set ::_mi_saved_xcodeversion $::macports::xcodeversion
    set ::macports::xcodeversion 27.0
    set ::portlib::toolchain::metal_info_cache [dict create]
    set ::portlib::toolchain::xcode_build_version_cache [dict create]
    set ::portlib::toolchain::toolchain_cache {}
    set ::portlib::toolchain::toolchain_cache_loaded 0
    file delete -force ${::macports::portdbpath}/cache/toolchaininfo
    rename ::exec ::_mi_real_exec
    proc ::exec {args} {
        if {[lindex $args 0] eq "plutil"} {
            return [::_mi_real_exec {*}$args]
        }
        if {[lsearch -exact $args -json] >= 0} {
            return {{"buildVersion":"27A300b","status":"installed","toolchainIdentifier":"com.apple.dt.toolchain.Metal.test","toolchainSearchPath":"/_test/metal"}}
        }
        return "Xcode 27.0\nBuild version 27A266a"
    }
} -body {
    set ctx [dict create \
        sdk_request     {} \
        sdkroot         {} \
        developer_dir   /_test_coherence_metal_suffix/Xcode.app/Contents/Developer \
        use_xcode       1 \
        xcodeversion    27.0 \
        xcodecltversion 27.0 \
        compiler        clang \
        needs_metal     1]
    llength [portlib::toolchain::check_coherence $ctx]
} -cleanup {
    rename ::exec {}
    rename ::_mi_real_exec ::exec
    set ::macports::xcodeversion $::_mi_saved_xcodeversion
    set ::portlib::toolchain::metal_info_cache [dict create]
    set ::portlib::toolchain::xcode_build_version_cache [dict create]
    set ::portlib::toolchain::toolchain_cache {}
    set ::portlib::toolchain::toolchain_cache_loaded 0
    file delete -force ${::macports::portdbpath}/cache/toolchaininfo
    unset ::_mi_saved_xcodeversion
} -result {0}


