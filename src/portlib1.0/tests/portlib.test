test coherence_sdk_older_than_compiler_is_silent {
    Axis B is one-directional: an SDK OLDER than the active Xcode/CLT
    generation is completely normal and must never be reported, at any
    distance. Request matches the real SDK exactly, so this isolates
    Axis B from Axis A.
} -setup {
    set ::_ch_sdkdir $pwd/tmp_coherence_older/MacOSX26.sdk
    _coherence_make_sdk $::_ch_sdkdir 26.0 macosx26.0
    set ::portlib::toolchain::sdk_info_cache [dict create]
} -body {
    set ctx [dict create \
        sdk_request     26 \
        sdkroot         $::_ch_sdkdir \
        developer_dir   /Applications/Xcode.app/Contents/Developer \
        use_xcode       1 \
        xcodeversion    27.0 \
        xcodecltversion 27.0 \
        compiler        clang \
        needs_metal     0]
    llength [portlib::toolchain::check_coherence $ctx]
} -cleanup {
    file delete -force $pwd/tmp_coherence_older
    set ::portlib::toolchain::sdk_info_cache [dict create]
    unset ::_ch_sdkdir
} -result {0}


test coherence_sdk_ahead_of_compiler_reported {
    Axis B's other direction: an SDK NEWER than the active Xcode/CLT
    generation (major comparison only) must report a notice finding.
    Request matches the real SDK exactly, isolating Axis B from Axis A.
} -setup {
    set ::_ch_sdkdir $pwd/tmp_coherence_ahead/MacOSX28.sdk
    _coherence_make_sdk $::_ch_sdkdir 28.0 macosx28.0
    set ::portlib::toolchain::sdk_info_cache [dict create]
} -body {
    set ctx [dict create \
        sdk_request     28 \
        sdkroot         $::_ch_sdkdir \
        developer_dir   /Applications/Xcode.app/Contents/Developer \
        use_xcode       1 \
        xcodeversion    27.0 \
        xcodecltversion 27.0 \
        compiler        clang \
        needs_metal     0]
    set findings [portlib::toolchain::check_coherence $ctx]
    list [llength $findings] [dict get [lindex $findings 0] axis] \
        [dict get [lindex $findings 0] severity]
} -cleanup {
    file delete -force $pwd/tmp_coherence_ahead
    set ::portlib::toolchain::sdk_info_cache [dict create]
    unset ::_ch_sdkdir
} -result {1 B notice}


test coherence_skips_macports_compiler {
    Axis B must be skipped entirely for a macports-provided compiler
    (compiler_is_port true): its version numbering has no relationship
    to Xcode/CLT generations at all. Same otherwise-Axis-B-triggering
    setup as coherence_sdk_ahead_of_compiler_reported.
} -setup {
    set ::_ch_sdkdir $pwd/tmp_coherence_skip_port/MacOSX28.sdk
    _coherence_make_sdk $::_ch_sdkdir 28.0 macosx28.0
