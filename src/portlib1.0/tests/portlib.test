    file delete -force ${::macports::portdbpath}/cache/toolchaininfo
    rename ::exec ::_mi_real_exec
    set ::_mi_json_calls 0
    proc ::exec {args} {
        if {[lindex $args 0] eq "plutil"} {
            # metal_info's own plist_value calls go through this same
            # ::exec, to extract fields out of the fake JSON below --
            # let plutil actually run, so plist_value's real parsing is
            # exercised end-to-end rather than also being stubbed out.
            return [::_mi_real_exec {*}$args]
        }
        if {[lsearch -exact $args -json] >= 0} {
            incr ::_mi_json_calls
            return [format {{"assetPath":"/a","buildVersion":"27A266a","status":"installed","toolchainIdentifier":"com.apple.dt.toolchain.Metal.test","toolchainSearchPath":"%s"}} $::_mi_search_path]
        }
        return "Xcode 27.0\nBuild version 27A266a"
    }
} -body {
    set first [portlib::toolchain::metal_info /_test_xcode/Xcode.app/Contents/Developer]

    set ::portlib::toolchain::metal_info_cache [dict create]
    set ::portlib::toolchain::xcode_build_version_cache [dict create]
    set ::portlib::toolchain::toolchain_cache {}
    set ::portlib::toolchain::toolchain_cache_loaded 0

    set second [portlib::toolchain::metal_info /_test_xcode/Xcode.app/Contents/Developer]
    list [dict get $first status] [dict get $first source] \
         [dict get $second status] [dict get $second build_version] \
         [dict get $second source] $::_mi_json_calls
} -cleanup {
    rename ::exec {}
    rename ::_mi_real_exec ::exec
    set ::macports::xcodeversion $::_mi_saved_xcodeversion
    set ::portlib::toolchain::metal_info_cache [dict create]
    set ::portlib::toolchain::xcode_build_version_cache [dict create]
    set ::portlib::toolchain::toolchain_cache {}
    set ::portlib::toolchain::toolchain_cache_loaded 0
