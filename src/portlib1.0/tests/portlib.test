test metal_info_forces_deferred_xcodeversion_read {
    macports::xcodeversion is set up with a deferred READ trace
    (macports::setxcodeinfo), and in Tcl "info exists" does NOT count as
    a read for trace purposes. metal_info's Xcode-version gate must
    therefore actually read $xcodeversion (forcing any such trace to
    fire), not short-circuit on [info exists xcodeversion] first -- or
    it would report "unsupported" on a real Xcode >= 26 host simply
    because nothing had touched xcodeversion yet. Simulated with a
    private trace standing in for macports::setxcodeinfo's real one,
    since that one may have already fired (and removed itself) earlier
    in this test run.
} -setup {
    set ::_mi_saved_xcodeversion $::macports::xcodeversion
    unset ::macports::xcodeversion
    trace add variable ::macports::xcodeversion read ::_mi_deferred_load
    proc ::_mi_deferred_load {name1 name2 op} {
        set ::macports::xcodeversion 27.0
        trace remove variable ::macports::xcodeversion read ::_mi_deferred_load
    }
    set ::portlib::toolchain::metal_info_cache [dict create]
    rename ::exec ::_mi_real_exec
    proc ::exec {args} {
        error "exec disabled for metal_info_forces_deferred_xcodeversion_read"
    }
} -body {
    set info [portlib::toolchain::metal_info /_test_xcode/Xcode.app/Contents/Developer]
    list [dict get $info supported] [info exists ::macports::xcodeversion] \
        $::macports::xcodeversion
} -cleanup {
    rename ::exec {}
    rename ::_mi_real_exec ::exec
    trace remove variable ::macports::xcodeversion read ::_mi_deferred_load
    catch {rename ::_mi_deferred_load {}}
    set ::macports::xcodeversion $::_mi_saved_xcodeversion
    set ::portlib::toolchain::metal_info_cache [dict create]
    unset ::_mi_saved_xcodeversion
} -result {1 1 27.0}


