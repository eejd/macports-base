test coherence_metal_unsupported_reported {
    Axis C when needs_metal is set but the active Xcode predates the
    separately-downloadable Metal component (< 26): one notice finding,
    and no exec at all (metal_info's own supported gate, #94).
} -setup {
    set ::_mi_saved_xcodeversion $::macports::xcodeversion
    set ::macports::xcodeversion 15.4
    set ::portlib::toolchain::metal_info_cache [dict create]
