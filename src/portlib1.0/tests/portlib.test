        }
        return "Xcode 27.0\nBuild version 27A266a"
    }
} -body {
    set info [portlib::toolchain::metal_info /_test_xcode/Xcode.app/Contents/Developer]
    list [dict get $info supported] [dict get $info status] \
         [dict get $info build_version] [dict get $info build_train] \
         [dict get $info toolchain_identifier] [dict get $info source]
} -cleanup {
    rename ::exec {}
    rename ::_mi_real_exec ::exec
    set ::macports::xcodeversion $::_mi_saved_xcodeversion
    set ::portlib::toolchain::metal_info_cache [dict create]
    set ::portlib::toolchain::xcode_build_version_cache [dict create]
    set ::portlib::toolchain::toolchain_cache {}
    set ::portlib::toolchain::toolchain_cache_loaded 0
    file delete -force ${::macports::portdbpath}/cache/toolchaininfo
    unset ::_mi_saved_xcodeversion
} -result {1 installed 27A266a 27A com.apple.dt.toolchain.Metal.test xcodebuild}


test metal_info_not_installed_is_not_disk_cached {
    Only an "installed" Metal status is trustworthy to disk-cache: any
    other status (the component not yet downloaded, or a transient probe
    hiccup) must be re-probed every invocation rather than risk pinning a
    stale answer on disk (issue #76's H4 hazard).
} -setup {
    set ::_mi_saved_xcodeversion $::macports::xcodeversion
    set ::macports::xcodeversion 27.0
    set ::portlib::toolchain::metal_info_cache [dict create]
    set ::portlib::toolchain::xcode_build_version_cache [dict create]
    set ::portlib::toolchain::toolchain_cache {}
    set ::portlib::toolchain::toolchain_cache_loaded 0
    file delete -force ${::macports::portdbpath}/cache/toolchaininfo
    rename ::exec ::_mi_real_exec
    proc ::exec {args} {
        if {[lindex $args 0] eq "plutil"} {
            # metal_info's own plist_value calls go through this same
            # ::exec, to extract fields out of the fake JSON below --
            # let plutil actually run, so plist_value's real parsing is
            # exercised end-to-end rather than also being stubbed out.
            return [::_mi_real_exec {*}$args]
        }
        if {[lsearch -exact $args -json] >= 0} {
            return {{"buildVersion":"27A266a","status":"notInstalled"}}
        }
        return "Xcode 27.0\nBuild version 27A266a"
    }
} -body {
    set info [portlib::toolchain::metal_info /_test_xcode/Xcode.app/Contents/Developer]
    set cache [macports::load_cache toolchaininfo]
    list [dict get $info supported] [dict get $info status] \
         [dict get $info source] [dict exists $cache metal]
} -cleanup {
    rename ::exec {}
    rename ::_mi_real_exec ::exec
    set ::macports::xcodeversion $::_mi_saved_xcodeversion
    set ::portlib::toolchain::metal_info_cache [dict create]
    set ::portlib::toolchain::xcode_build_version_cache [dict create]
    set ::portlib::toolchain::toolchain_cache {}
    set ::portlib::toolchain::toolchain_cache_loaded 0
    file delete -force ${::macports::portdbpath}/cache/toolchaininfo
    unset ::_mi_saved_xcodeversion
} -result {1 notInstalled xcodebuild 0}


test metal_info_disk_cache_roundtrip {
    A disk cache hit must survive a fresh process (simulated here by
    resetting every in-memory memo, including the toolchain_cache load
    flag, forcing an actual re-read of the toolchaininfo file the first
    call wrote) and must skip the expensive `xcodebuild -json
    -showComponent MetalToolchain` probe on that second call -- proven by
    counting only -json invocations, since the cheap `-version` probe
    (xcode_build_version) legitimately runs every time to validate the
    cache is still fresh.
