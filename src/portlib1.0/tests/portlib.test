# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

package require tcltest 2
namespace import tcltest::*

set pwd [file dirname [file normalize $argv0]]

set macports_dir $pwd/../../macports1.0
source ${macports_dir}/macports_test_autoconf.tcl
source ${macports_dir}/tests/test_setup.tcl

package require portlib

test get_archive_sites_conf_values {
    Get archive sites conf values unit test.
} -setup {
    file mkdir $pwd/archive_sites
    set fd [open $pwd/archive_sites/archive_sites.conf w+]
    puts $fd "name fondu"
    puts $fd "urls macports.org"
    puts $fd "type tgz"
    close $fd

    set macports::archive_sites_conf $pwd/archive_sites/archive_sites.conf
} -body {
    set res [portlib::archive_sites::get_archive_sites_conf_values]
    puts $res
    if {![dict exists $res sites fondu]} {
        return "FAIL: name not set"
    }
    if {[dict get $res sites fondu] ne "macports.org:nosubdir"} {
        return "FAIL: wrong sites set"
    }
    if {![dict exists $res archive_type fondu]} {
        return "FAIL: type not set"
    }
    if {[dict get $res archive_type fondu] ne "tgz"} {
        return "FAIL: wrong type set"
    }

    return "Get archive sites conf values successful."

} -cleanup {
    file delete -force $pwd/archive_sites
} -result "Get archive sites conf values successful."


test get_sdkroot_use_xcode_prefers_xcode_sdk {
    Regression test for base issue #75: with use_xcode set, get_sdkroot must
    resolve the SDK from Xcode's own SDKs directory when it has a match,
    even if the requested sdk_version equals the running macOS major
    version (the case that made a CommandLineTools SDK look "closer").
} -setup {
    set ::_gsr_saved(developer_dir) $::macports::developer_dir
    set ::_gsr_saved(xcodeversion) $::macports::xcodeversion
    set ::_gsr_saved(macos_version_major) $::macports::macos_version_major
    set ::_gsr_saved(macos_version) $::macports::macos_version

    set ::macports::developer_dir /Applications/Xcode.app/Contents/Developer
    set ::macports::xcodeversion 16.0
    set ::macports::macos_version_major 15
    set ::macports::macos_version 15.0

    set ::portlib::configure::sdkroot_cache [dict create]

    rename ::portlib::configure::file_exists ::_gsr_real_file_exists
    proc ::portlib::configure::file_exists {path} {
        return [expr {$path eq "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX15.sdk"}]
    }
} -body {
    portlib::configure::get_sdkroot 15 1
} -cleanup {
    rename ::portlib::configure::file_exists {}
    rename ::_gsr_real_file_exists ::portlib::configure::file_exists
    set ::macports::developer_dir $::_gsr_saved(developer_dir)
    set ::macports::xcodeversion $::_gsr_saved(xcodeversion)
    set ::macports::macos_version_major $::_gsr_saved(macos_version_major)
    set ::macports::macos_version $::_gsr_saved(macos_version)
    set ::portlib::configure::sdkroot_cache [dict create]
    array unset ::_gsr_saved
} -result "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX15.sdk"


test get_sdkroot_use_xcode_does_not_cross_to_clt {
    Regression test for base issue #75: with use_xcode set, get_sdkroot must
    never fall through to a CommandLineTools-only SDK, even when one is
    present and Xcode's own SDKs directory has no match -- returning that
    SDK would pair Xcode's DEVELOPER_DIR with a different toolchain's
    SDKROOT. Simulates the reported failure mode: Xcode ships an older SDK
    (or none at that version) while the standalone CommandLineTools ship a
    newer one matching the running OS major version.
} -setup {
    set ::_gsr_saved(developer_dir) $::macports::developer_dir
    set ::_gsr_saved(xcodeversion) $::macports::xcodeversion
    set ::_gsr_saved(macos_version_major) $::macports::macos_version_major
    set ::_gsr_saved(macos_version) $::macports::macos_version

    set ::macports::developer_dir /Applications/Xcode.app/Contents/Developer
    set ::macports::xcodeversion 16.0
    set ::macports::macos_version_major 15
    set ::macports::macos_version 15.0

    set ::portlib::configure::sdkroot_cache [dict create]

    # Only the CommandLineTools path "exists" -- the bug scenario.
    rename ::portlib::configure::file_exists ::_gsr_real_file_exists
    proc ::portlib::configure::file_exists {path} {
        return [expr {$path eq "/Library/Developer/CommandLineTools/SDKs/MacOSX15.sdk"}]
    }
    rename ::portlib::configure::find_close_sdk ::_gsr_real_find_close_sdk
    proc ::portlib::configure::find_close_sdk {sdk_version sdk_path} {
        return {}
    }
    rename ::exec ::_gsr_real_exec
    proc ::exec {args} {
        error "exec disabled for get_sdkroot_use_xcode_does_not_cross_to_clt"
    }
} -body {
    portlib::configure::get_sdkroot 15 1
} -cleanup {
    rename ::exec {}
    rename ::_gsr_real_exec ::exec
    rename ::portlib::configure::find_close_sdk {}
    rename ::_gsr_real_find_close_sdk ::portlib::configure::find_close_sdk
    rename ::portlib::configure::file_exists {}
    rename ::_gsr_real_file_exists ::portlib::configure::file_exists
    set ::macports::developer_dir $::_gsr_saved(developer_dir)
    set ::macports::xcodeversion $::_gsr_saved(xcodeversion)
    set ::macports::macos_version_major $::_gsr_saved(macos_version_major)
    set ::macports::macos_version $::_gsr_saved(macos_version)
    set ::portlib::configure::sdkroot_cache [dict create]
    array unset ::_gsr_saved
} -result {}


test get_sdkroot_no_use_xcode_still_prefers_clt {
    Confirms the !use_xcode search order is unchanged by the use_xcode fix
    above: without use_xcode, get_sdkroot must still resolve from the
    CommandLineTools SDKs directory first.
} -setup {
    set ::portlib::configure::sdkroot_cache [dict create]

    rename ::portlib::configure::file_exists ::_gsr_real_file_exists
    proc ::portlib::configure::file_exists {path} {
        return [expr {$path eq "/Library/Developer/CommandLineTools/SDKs/MacOSX15.sdk"}]
    }
} -body {
    portlib::configure::get_sdkroot 15 0
} -cleanup {
    rename ::portlib::configure::file_exists {}
    rename ::_gsr_real_file_exists ::portlib::configure::file_exists
    set ::portlib::configure::sdkroot_cache [dict create]
} -result "/Library/Developer/CommandLineTools/SDKs/MacOSX15.sdk"


test get_sdkroot_no_use_xcode_falls_through_to_xcode_sdks_dir {
    Coverage gap flagged in independent review of PR #89: without
    use_xcode, if the CommandLineTools search finds nothing at all,
    get_sdkroot must still fall through to the shared search block and
    find a match under Xcode's own SDKs directory -- exercising the
    try_paths list's else branch (which, for !use_xcode, still includes
    ${cltpath}/SDKs, unchanged from before the fix) and the shared search
    block itself, neither of which
    get_sdkroot_no_use_xcode_still_prefers_clt reaches (it returns from
    the CommandLineTools-only early block first). Does not exercise the
    !use_xcode-gated second CLT fallback below the shared loop -- result
    is already set by the time that block would run, since this test's
    match is found in the shared loop's first iteration; that guard's
    !use_xcode=0 behavior is unchanged from pre-fix and is indirectly
    covered by get_sdkroot_use_xcode_does_not_cross_to_clt proving it
    matters for use_xcode=1.
} -setup {
    set ::_gsr_saved(developer_dir) $::macports::developer_dir
    set ::_gsr_saved(xcodeversion) $::macports::xcodeversion
    set ::_gsr_saved(macos_version_major) $::macports::macos_version_major
    set ::_gsr_saved(macos_version) $::macports::macos_version

    set ::macports::developer_dir /Applications/Xcode.app/Contents/Developer
    set ::macports::xcodeversion 16.0
    set ::macports::macos_version_major 15
    set ::macports::macos_version 15.5

    set ::portlib::configure::sdkroot_cache [dict create]

    # Nothing matches under CommandLineTools; only Xcode's own SDKs
    # directory has the requested version.
    rename ::portlib::configure::file_exists ::_gsr_real_file_exists
    proc ::portlib::configure::file_exists {path} {
        return [expr {$path eq "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX15.sdk"}]
    }
    rename ::portlib::configure::find_close_sdk ::_gsr_real_find_close_sdk
    proc ::portlib::configure::find_close_sdk {sdk_version sdk_path} {
        return {}
    }
    rename ::exec ::_gsr_real_exec
    proc ::exec {args} {
        error "exec disabled for get_sdkroot_no_use_xcode_falls_through_to_xcode_sdks_dir"
    }
} -body {
    portlib::configure::get_sdkroot 15 0
} -cleanup {
    rename ::exec {}
    rename ::_gsr_real_exec ::exec
    rename ::portlib::configure::find_close_sdk {}
    rename ::_gsr_real_find_close_sdk ::portlib::configure::find_close_sdk
    rename ::portlib::configure::file_exists {}
    rename ::_gsr_real_file_exists ::portlib::configure::file_exists
    set ::macports::developer_dir $::_gsr_saved(developer_dir)
    set ::macports::xcodeversion $::_gsr_saved(xcodeversion)
    set ::macports::macos_version_major $::_gsr_saved(macos_version_major)
    set ::macports::macos_version $::_gsr_saved(macos_version)
    set ::portlib::configure::sdkroot_cache [dict create]
    array unset ::_gsr_saved
} -result "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX15.sdk"


test get_sdkroot_use_xcode_falls_through_to_xcrun {
    Coverage gap flagged in independent review of PR #89: with use_xcode
    set, if no SDK is found on disk under Xcode's own SDKs directory,
    get_sdkroot must still resolve via the bare `xcrun --sdk
    macosx<version>` fallback (which respects xcode-select's active
    developer directory) -- proving that path is actually reached, not
    just that the CommandLineTools crossing is avoided (which
    get_sdkroot_use_xcode_does_not_cross_to_clt already covers by
    disabling exec entirely).
} -setup {
    set ::_gsr_saved(developer_dir) $::macports::developer_dir
    set ::_gsr_saved(xcodeversion) $::macports::xcodeversion
    set ::_gsr_saved(macos_version_major) $::macports::macos_version_major
    set ::_gsr_saved(macos_version) $::macports::macos_version

    set ::macports::developer_dir /Applications/Xcode.app/Contents/Developer
    set ::macports::xcodeversion 16.0
    set ::macports::macos_version_major 15
    set ::macports::macos_version 15.5

    set ::portlib::configure::sdkroot_cache [dict create]

    rename ::portlib::configure::file_exists ::_gsr_real_file_exists
    proc ::portlib::configure::file_exists {path} {
        return 0
    }
    rename ::portlib::configure::find_close_sdk ::_gsr_real_find_close_sdk
    proc ::portlib::configure::find_close_sdk {sdk_version sdk_path} {
        return {}
    }
    # Only succeed for the specific xcrun --sdk macosx15... probe used by
    # the try_versions/exec fallback, so this test proves that exact path
    # is reached rather than passing via some other exec call (e.g. the
    # final bare `xcrun --sdk macosx` fallback, which never mentions
    # "macosx15").
    rename ::exec ::_gsr_real_exec
    proc ::exec {args} {
        foreach a $args {
            if {[string match "macosx15*" $a]} {
                return "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX15.0.sdk"
            }
        }
        error "exec disabled except for the macosx15* xcrun probe in get_sdkroot_use_xcode_falls_through_to_xcrun"
    }
} -body {
    portlib::configure::get_sdkroot 15 1
} -cleanup {
    rename ::exec {}
    rename ::_gsr_real_exec ::exec
    rename ::portlib::configure::find_close_sdk {}
    rename ::_gsr_real_find_close_sdk ::portlib::configure::find_close_sdk
    rename ::portlib::configure::file_exists {}
    rename ::_gsr_real_file_exists ::portlib::configure::file_exists
    set ::macports::developer_dir $::_gsr_saved(developer_dir)
    set ::macports::xcodeversion $::_gsr_saved(xcodeversion)
    set ::macports::macos_version_major $::_gsr_saved(macos_version_major)
    set ::macports::macos_version $::_gsr_saved(macos_version)
    set ::portlib::configure::sdkroot_cache [dict create]
    array unset ::_gsr_saved
} -result "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX15.0.sdk"


test sdk_info_empty_sdkroot {
    sdk_info must degrade gracefully for an empty sdkroot -- the DevSDK
    case (configure_get_sdkroot returns {} when the host's bundled headers
    satisfy the request) -- returning an all-empty dict with source "none"
    rather than throwing or probing the filesystem.
} -body {
    set info [portlib::toolchain::sdk_info {}]
    list [dict get $info path] [dict get $info version] \
        [dict get $info provider] [dict get $info source]
} -result {{} {} {} none}


test sdk_info_reads_real_version_not_path {
    Regression coverage for issue #76: a directory named "MacOSX26.sdk" is
    not necessarily version 26, or even 26.x -- on this fork's SDK trees a
    directory of that name has been observed to be a symlink whose
    SDKSettings.plist reports version 26.5. sdk_info must return the real
    version read from the plist, not a version parsed from the directory
    name, whenever the plist is readable.
} -setup {
    set ::_si_sdkdir $pwd/tmp_sdk_MacOSX26.sdk
    file mkdir $::_si_sdkdir
    set fd [open $::_si_sdkdir/SDKSettings.plist w]
    puts $fd {<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Version</key>
	<string>26.5</string>
	<key>CanonicalName</key>
	<string>macosx26.5</string>
	<key>DisplayName</key>
	<string>macOS 26.5</string>
</dict>
</plist>}
    close $fd
    set ::portlib::toolchain::sdk_info_cache [dict create]
} -body {
    set info [portlib::toolchain::sdk_info $::_si_sdkdir]
    list [dict get $info version] [dict get $info version_major] \
        [dict get $info canonical_name] [dict get $info source]
} -cleanup {
    file delete -force $::_si_sdkdir
    set ::portlib::toolchain::sdk_info_cache [dict create]
    unset ::_si_sdkdir
} -result {26.5 26 macosx26.5 plist}


test sdk_info_falls_back_to_path_when_plist_unreadable {
    If SDKSettings.plist cannot be read (missing plutil, permissions,
    malformed content, etc.), sdk_info must still return a usable version
    by parsing it out of the directory name -- the same signal
    configure::find_close_sdk already relies on -- rather than throwing or
    returning an unusable dict. Simulated here by disabling exec entirely,
    which is what plist_value's plutil invocation goes through.
} -setup {
    set ::portlib::toolchain::sdk_info_cache [dict create]
    rename ::exec ::_si_real_exec
    proc ::exec {args} {
        error "exec disabled for sdk_info_falls_back_to_path_when_plist_unreadable"
    }
} -body {
    set info [portlib::toolchain::sdk_info /nonexistent/MacOSX28.sdk]
    list [dict get $info version] [dict get $info version_major] \
        [dict get $info canonical_name] [dict get $info source]
} -cleanup {
    rename ::exec {}
    rename ::_si_real_exec ::exec
    set ::portlib::toolchain::sdk_info_cache [dict create]
} -result {28 28 {} path}


test sdk_info_provider_identifies_clt_vs_xcode {
    sdk_info's provider/developer_dir fields must identify which developer
    dir actually supplied the SDK from where the path resolves on disk --
    provenance a Portfile or PortGroup previously had no supported way to
    ask for (issue #76 point 7). metal_toolchain-1.0.tcl's own comments
    describe re-deriving this by parsing configure.sdkroot as a string,
    and record that the CLT and Xcode trees' symlink shapes point in
    opposite directions, so a string parse can't recover it reliably;
    sdk_info answers it directly from the resolved path instead.
} -setup {
    set ::_si_saved_developer_dir $::macports::developer_dir
    set ::macports::developer_dir /_test_xcode/Xcode.app/Contents/Developer
    set ::portlib::toolchain::sdk_info_cache [dict create]
    rename ::exec ::_si_real_exec
    proc ::exec {args} {
        error "exec disabled for sdk_info_provider_identifies_clt_vs_xcode"
    }
} -body {
    set clt [portlib::toolchain::sdk_info /Library/Developer/CommandLineTools/SDKs/MacOSX26.sdk]
    set xc [portlib::toolchain::sdk_info /_test_xcode/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX27.sdk]
    set other [portlib::toolchain::sdk_info /opt/other-sdks/MacOSX27.sdk]
    list \
        [dict get $clt provider] [dict get $clt developer_dir] \
        [dict get $xc provider] [dict get $xc developer_dir] \
        [dict get $other provider] [dict get $other developer_dir]
} -cleanup {
    rename ::exec {}
    rename ::_si_real_exec ::exec
    set ::macports::developer_dir $::_si_saved_developer_dir
    set ::portlib::toolchain::sdk_info_cache [dict create]
    unset ::_si_saved_developer_dir
} -result {clt /Library/Developer/CommandLineTools xcode /_test_xcode/Xcode.app/Contents/Developer other {}}


test sdk_info_provider_regexp_fallback_for_other_xcode_installs {
    Coverage gap flagged in independent review of PR #93: the CLT-prefix
    and developer_dir-prefix checks above don't exercise the third
    provider branch -- the ".app/Contents/Developer" regexp fallback that
    identifies an SDK as belonging to Xcode even when it comes from an
    Xcode.app that isn't the currently-active developer_dir (e.g. a second
    Xcode install selected only for this one SDK lookup, not via
    xcode-select). Uses a developer_dir that matches neither the CLT
    prefix nor the SDK path, so only the regexp branch can produce a
    non-"other" result.
} -setup {
    set ::_si_saved_developer_dir $::macports::developer_dir
    set ::macports::developer_dir /_test_active_xcode/Xcode.app/Contents/Developer
    set ::portlib::toolchain::sdk_info_cache [dict create]
    rename ::exec ::_si_real_exec
    proc ::exec {args} {
        error "exec disabled for sdk_info_provider_regexp_fallback_for_other_xcode_installs"
    }
} -body {
    set info [portlib::toolchain::sdk_info /_test_other_xcode/Xcode-beta.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX28.sdk]
    list [dict get $info provider] [dict get $info developer_dir]
} -cleanup {
    rename ::exec {}
    rename ::_si_real_exec ::exec
    set ::macports::developer_dir $::_si_saved_developer_dir
    set ::portlib::toolchain::sdk_info_cache [dict create]
    unset ::_si_saved_developer_dir
} -result {xcode /_test_other_xcode/Xcode-beta.app/Contents/Developer}


test sdk_info_cache_keyed_by_path_not_by_sdk_version_use_xcode {
    Unlike configure::sdkroot_cache (keyed only on sdk_version,use_xcode,
    so it cannot distinguish two different resolved paths for the same
    request -- see issue #76's H1 hazard), sdk_info's cache is keyed on the
    resolved path itself. Two different sdkroot paths must never collide
    in the cache even though nothing here ever calls get_sdkroot.
} -setup {
    set ::portlib::toolchain::sdk_info_cache [dict create]
    rename ::exec ::_si_real_exec
    proc ::exec {args} {
        error "exec disabled for sdk_info_cache_keyed_by_path_not_by_sdk_version_use_xcode"
    }
} -body {
    set a [portlib::toolchain::sdk_info /path/one/MacOSX26.sdk]
    set b [portlib::toolchain::sdk_info /path/two/MacOSX26.sdk]
    list [dict get $a path] [dict get $b path]
} -cleanup {
    rename ::exec {}
    rename ::_si_real_exec ::exec
    set ::portlib::toolchain::sdk_info_cache [dict create]
} -result {/path/one/MacOSX26.sdk /path/two/MacOSX26.sdk}


test plist_value_missing_key_returns_empty {
    plist_value must return the empty string, not throw, when the key
    doesn't exist in an otherwise-readable plist.
} -body {
    # Not a plist at all -- proves plutil failure degrades to {} rather
    # than propagating an error.
    portlib::toolchain::plist_value [list file $pwd/portlib.test] SomeKey
} -result {}


test plist_value_reads_json_from_data_source {
    plist_value's "data" source form must be able to parse JSON bytes (the
    output of `xcodebuild -json ...`, which PR2's metal_info will consume)
    supplied on stdin, not just a plist file on disk.
} -body {
    set json {{"buildVersion":"27A266a","status":"installed"}}
    list [portlib::toolchain::plist_value [list data $json] buildVersion] \
         [portlib::toolchain::plist_value [list data $json] status]
} -result {27A266a installed}


test build_train_parsing {
    build_train extracts the opaque, numeric-plus-letter "build train"
    prefix used for the Metal<->Xcode equality check (issue #76's Axis
    C) -- and only that: it must NOT be treated as encoding a marketing
    minor version, since Apple skips letters (Xcode 16.3 is build
    "16E140", 16.4 is build "16F6" -- "E" is neither 4 nor "one before
    F").
} -body {
    list \
        [portlib::toolchain::build_train 27A266a] \
        [portlib::toolchain::build_train 16E140] \
        [portlib::toolchain::build_train 16F6] \
        [portlib::toolchain::build_train {}] \
        [portlib::toolchain::build_train notabuild]
} -result {27A 16E 16F {} {}}


test xcode_build_version_parses_build_line {
    xcode_build_version must return the build string from the SECOND
    line of `xcodebuild -version` output (e.g. "27A266a" out of "Build
    version 27A266a"), not the marketing version on the first line.
} -setup {
    set ::portlib::toolchain::xcode_build_version_cache [dict create]
    rename ::exec ::_xbv_real_exec
    proc ::exec {args} {
        return "Xcode 27.0\nBuild version 27A266a"
    }
} -body {
    portlib::toolchain::xcode_build_version /_test_xcode/Xcode.app/Contents/Developer
} -cleanup {
    rename ::exec {}
    rename ::_xbv_real_exec ::exec
    set ::portlib::toolchain::xcode_build_version_cache [dict create]
} -result {27A266a}


test xcode_build_version_returns_empty_on_failure {
    xcode_build_version must return {}, not throw, when xcodebuild
    -version fails or produces output that doesn't match the expected
    "Build version ..." shape.
} -setup {
    set ::portlib::toolchain::xcode_build_version_cache [dict create]
    rename ::exec ::_xbv_real_exec
    proc ::exec {args} {
        error "exec disabled for xcode_build_version_returns_empty_on_failure"
    }
} -body {
    portlib::toolchain::xcode_build_version /_test_xcode/Xcode.app/Contents/Developer
} -cleanup {
    rename ::exec {}
    rename ::_xbv_real_exec ::exec
    set ::portlib::toolchain::xcode_build_version_cache [dict create]
} -result {}


test xcode_build_version_disk_cache_roundtrip {
    xcode_build_version's disk cache (distinct from macports::xcodeinfo --
    see the toolchaininfo cache file's doc comment) is keyed on the Xcode
    installation's Info.plist mtime: a second call for the same
    developer_dir, after every in-memory memo -- including the
    toolchain_cache load flag -- is cleared to simulate a fresh process,
    must return the same build version without invoking xcodebuild again.
} -setup {
    set ::_xbv_dir $pwd/tmp_xbv_xcode
    file mkdir $::_xbv_dir/Xcode.app/Contents
    close [open $::_xbv_dir/Xcode.app/Contents/Info.plist w]
    set ::_xbv_developer_dir $::_xbv_dir/Xcode.app/Contents/Developer
    file mkdir $::_xbv_developer_dir
    set ::portlib::toolchain::xcode_build_version_cache [dict create]
    set ::portlib::toolchain::toolchain_cache {}
    set ::portlib::toolchain::toolchain_cache_loaded 0
    file delete -force ${::macports::portdbpath}/cache/toolchaininfo
    rename ::exec ::_xbv_real_exec
    set ::_xbv_calls 0
    proc ::exec {args} {
        incr ::_xbv_calls
        if {$::_xbv_calls > 1} {
            error "xcodebuild -version invoked a second time -- disk cache was not used"
        }
        return "Xcode 27.0\nBuild version 27A266a"
    }
} -body {
    set first [portlib::toolchain::xcode_build_version $::_xbv_developer_dir]

    set ::portlib::toolchain::xcode_build_version_cache [dict create]
    set ::portlib::toolchain::toolchain_cache {}
    set ::portlib::toolchain::toolchain_cache_loaded 0

    set second [portlib::toolchain::xcode_build_version $::_xbv_developer_dir]
    list $first $second $::_xbv_calls
} -cleanup {
    rename ::exec {}
    rename ::_xbv_real_exec ::exec
    file delete -force $::_xbv_dir
    set ::portlib::toolchain::xcode_build_version_cache [dict create]
    set ::portlib::toolchain::toolchain_cache {}
    set ::portlib::toolchain::toolchain_cache_loaded 0
    file delete -force ${::macports::portdbpath}/cache/toolchaininfo
    unset ::_xbv_dir ::_xbv_developer_dir ::_xbv_calls
} -result {27A266a 27A266a 1}


test metal_info_unsupported_on_old_xcode {
    metal_info must report supported 0 -- with NO exec at all -- when
    the active Xcode predates the separately-downloadable Metal
    component (introduced in Xcode 26), rather than probing and getting
    a meaningless answer.
} -setup {
