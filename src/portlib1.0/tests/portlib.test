# check_coherence tests. A helper to build a real SDKSettings.plist
# fixture -- like #93's sdk_info_reads_real_version_not_path -- since
# check_coherence's Axis A reads sdk_info, which reads the plist via the
# real plutil(1) (no exec stubbing needed or wanted for this: proving
# the real plist-parsing path is exercised, exactly as #93 established).
proc _coherence_make_sdk {dir version canonical_name} {
    file mkdir $dir
    set fd [open $dir/SDKSettings.plist w]
    puts $fd "<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">
<plist version=\"1.0\">
<dict>
	<key>Version</key>
	<string>${version}</string>
	<key>CanonicalName</key>
	<string>${canonical_name}</string>
	<key>DisplayName</key>
	<string>macOS ${version}</string>
</dict>
</plist>"
    close $fd
}


test coherence_default_config_is_silent {
    The compatibility-gate guard: a default, coherent configuration --
    bare-major SDK request matching the real resolved SDK's major, active
    Xcode generation at or above the SDK, no needs_metal -- must produce
    ZERO findings of any severity. This is the single test standing
    between this whole series and warning on every port on every Mac
    (issue #76's H7 hazard).
} -setup {
    set ::_ch_sdkdir $pwd/tmp_coherence_default/MacOSX27.sdk
    _coherence_make_sdk $::_ch_sdkdir 27.0 macosx27.0
    set ::portlib::toolchain::sdk_info_cache [dict create]
} -body {
    set ctx [dict create \
        sdk_request     27 \
        sdkroot         $::_ch_sdkdir \
        developer_dir   /Applications/Xcode.app/Contents/Developer \
        use_xcode       1 \
        xcodeversion    27.0 \
        xcodecltversion 27.0 \
        compiler        clang \
        needs_metal     0]
    llength [portlib::toolchain::check_coherence $ctx]
} -cleanup {
    file delete -force $pwd/tmp_coherence_default
    set ::portlib::toolchain::sdk_info_cache [dict create]
    unset ::_ch_sdkdir
} -result {0}


test coherence_sdk_request_minor_drift_is_silent {
    A bare-major request satisfied by a real SDK with a non-.0 minor
    (e.g. request "26", real "26.5" -- the CLT's actual shape on this
    fork's SDK trees) must produce zero NOTICE findings. An info finding
    recording the drift is fine and expected (reserved for a future
    `port diagnose`), but must never be escalated.
} -setup {
    set ::_ch_sdkdir $pwd/tmp_coherence_minor_drift/MacOSX26.sdk
    _coherence_make_sdk $::_ch_sdkdir 26.5 macosx26.5
    set ::portlib::toolchain::sdk_info_cache [dict create]
} -body {
    set ctx [dict create \
        sdk_request     26 \
        sdkroot         $::_ch_sdkdir \
        developer_dir   /Applications/Xcode.app/Contents/Developer \
        use_xcode       1 \
        xcodeversion    27.0 \
        xcodecltversion 27.0 \
        compiler        clang \
        needs_metal     0]
    set findings [portlib::toolchain::check_coherence $ctx]
    llength [lsearch -all -inline [lmap f $findings {dict get $f severity}] notice]
} -cleanup {
    file delete -force $pwd/tmp_coherence_minor_drift
    set ::portlib::toolchain::sdk_info_cache [dict create]
    unset ::_ch_sdkdir
} -result {0}


