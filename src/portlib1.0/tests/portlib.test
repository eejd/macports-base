    rename ::_mi_real_exec ::exec
    set ::macports::xcodeversion $::_mi_saved_xcodeversion
    set ::portlib::toolchain::metal_info_cache [dict create]
    unset ::_mi_saved_xcodeversion
} -result {1 C notice}


test coherence_provenance_info_is_never_notice {
    Axis D (provenance) must always be severity info, even when a real
    mismatch is present -- it is never escalated by any policy. The SDK
    resolves (via its own path, through the .app/Contents/Developer
    regexp fallback -- see #93) to a different developer_dir than the
    one in ctx. sdkroot's directory name deliberately has no version
    digits ("MacOSX.sdk" with no readable plist), so Axis A/B stay
    silent (empty version) and this test isolates Axis D.
} -setup {
    set ::portlib::toolchain::sdk_info_cache [dict create]
} -body {
    set ctx [dict create \
        sdk_request     {} \
        sdkroot         /Applications/XcodeA.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk \
        developer_dir   /Applications/XcodeB.app/Contents/Developer \
        use_xcode       1 \
        xcodeversion    27.0 \
        xcodecltversion 27.0 \
        compiler        clang \
        needs_metal     0]
    set findings [portlib::toolchain::check_coherence $ctx]
    list [llength $findings] [dict get [lindex $findings 0] axis] \
        [dict get [lindex $findings 0] severity]
} -cleanup {
    set ::portlib::toolchain::sdk_info_cache [dict create]
} -result {1 D info}


test supportedArchiveTypes {
    Supported archive types unit test.
    Only tests xar, zip, cpio.
} -body {
    set archives [portlib::util::supportedArchiveTypes]

    foreach archive $archives {
        if {$archive == "xar" && ![file exists ${::portlib::autoconf::xar_path}]} {
            return "FAIL: xar detected but inexistent"
        }
        if {$archive == "zip" && ![file exists ${::portlib::autoconf::zip_path}]} {
            return "FAIL: zip detected but inexistent"
        }
        if {$archive == "cpio" && ![file exists ${::portlib::autoconf::pax_path}]} {
            return "FAIL: cpio detected but inexistent"
        }
    }
    return "Supported archives successful."
} -result "Supported archives successful."


cleanupTests
